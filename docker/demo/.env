################################################################################
#                             ORCHEALM-API CONFIGURATION                           #
################################################################################
# PostgreSQL database host
DATABASE_HOST=db

# PostgreSQL database port
DATABASE_PORT=5432

# Name of the database
DATABASE_NAME=orchealm-api-db

# Database admin username
DATABASE_ADMIN_USER=admin

# Database username
DATABASE_USER=orchealm_api

# Database admin password
DATABASE_ADMIN_PASSWORD=password

# Database password
DATABASE_PASSWORD=password

# External ID of the super admin user
SUPER_ADMIN_EXTERNAL_ID=test

# Enable or disable Swagger UI
SWAGGER_ENABLED=true

# Logging level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL=INFO

# External issuer URL, as it appears in the token's iss claim (seen by the browser)
AUTH_ISSUER_URI=https://localhost:9000/oidc/realms/local-realm

# Internal JWKS endpoint, reachable from the api container
AUTH_JWK_SET_URI=http://keycloak:8080/realms/local-realm/protocol/openid-connect/certs

# Path to SSL/TLS key store
SSL_KEY_STORE=classpath:keystore.jks

# Password for accessing the SSL key store
SSL_KEY_STORE_PASSWORD=password

# Password for the individual SSL key within the key store
SSL_KEY_PASSWORD=password

################################################################################
#                             KEYCLOAK CONFIGURATION                           #
################################################################################
# Admin username to authenticate with Keycloak for management tasks
KEYCLOAK_ADMIN_USERNAME=superAdmin

# Password for the Keycloak admin user
KEYCLOAK_ADMIN_PASSWORD=password

# Client ID for fetching admin token via password grant
KEYCLOAK_ADMIN_CLIENT_ID=orchealm-api

# Base URL for Keycloak admin REST API (token endpoint)
KEYCLOAK_ADMIN_TOKEN_URL=http://keycloak:8080/realms/local-realm/protocol/openid-connect/token

# Base URL for Keycloak admin CLI API (for user management)
KEYCLOAK_ADMIN_CLI_URL=http://keycloak:8080/realms/master/protocol/openid-connect/token

# Client ID used for CLI access (to reset user passwords)
KEYCLOAK_ADMIN_CLI_CLIENT_ID=admin-cli

# Base URL for Keycloak user management API
KEYCLOAK_USERS_API_URL=http://keycloak:8080/admin/realms/local-realm/users

# URL to check Keycloak health (used to wait until Keycloak is ready)
KEYCLOAK_HEALTH_URL=http://keycloak:8080/realms/local-realm

################################################################################
#                         VERSION CHECKER CONFIGURATION                        #
################################################################################

# OAuth2 client used by version checker
VERSION_CHECKER_USERNAME=bot
VERSION_CHECKER_PASSWORD=password
VERSION_CHECKER_CLIENT_ID=orchealm-api
VERSION_CHECKER_CLIENT_SECRET=super-secret-password

# Keycloak token endpoint
VERSION_CHECKER_TOKEN_URL=http://keycloak:8080/realms/local-realm/protocol/openid-connect/token

# API endpoint used to update versions
VERSION_CHECKER_API_URL=https://api:8443

VERSION_CHECKER_DEFAULT_TEAM=PLATFORM
VERSION_CHECKER_DEFAULT_ENVIRONMENT=OFFICIAL
VERSION_CHECKER_DEFAULT_CLIENT=Internal

################################################################################
#                             E2E TESTS CONFIGURATION                          #
################################################################################
# Path to Cucumber feature files used for E2E tests
CYPRESS_FEATURES_PATH=/app/features

# Base URL of the Frontend to be tested in E2E scenarios
E2E_FRONT_URL=http://linid-im-front

# Base URL of the API to be tested in E2E scenarios
E2E_API_URL=https://localhost:8443

# Keycloak token endpoint for E2E authentication
E2E_KEYCLOAK_URL=http://localhost:8080/realms/local-realm/protocol/openid-connect/token

# Client ID used to authenticate against Keycloak during E2E tests
E2E_KEYCLOAK_CLIENT_ID=orchealm-ui
